# Airtable Personal Access Token (required for Airtable agent)
# Create at: https://airtable.com/create/tokens
AIRTABLE_PAT=patxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nithin's view (store mapping) — base, table, view from the Airtable URL
# Example: https://airtable.com/appmSjXVMWR99duPQ/tblub3DbzKIrfh4UA/viwBofuDyDvgxnXaJ
# AIRTABLE_STORE_MAPPING_BASE_ID=appmSjXVMWR99duPQ
# AIRTABLE_STORE_MAPPING_TABLE_ID=tblub3DbzKIrfh4UA
# AIRTABLE_STORE_MAPPING_VIEW_ID=viwBofuDyDvgxnXaJ

# Optional: financial/promo/ads tables (if you use Airtable for transaction data)
# AIRTABLE_FINANCIAL_BASE_ID=appXXXXXXXXXXXXXX
# AIRTABLE_FINANCIAL_TABLE=Transactions
