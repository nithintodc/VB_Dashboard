# Airtable Personal Access Token (required for store mapping fetch)
# Create at: https://airtable.com/create/tokens — copy your token below
# For sidebar filters to show Account / Brand names (not rec… IDs), enable scope: schema.bases:read
AIRTABLE_PAT=patxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Store mapping — same base/table, three views (DoorDash / Uber Eats / Grubhub)
AIRTABLE_STORE_MAPPING_BASE_ID=appmSjXVMWR99duPQ
AIRTABLE_STORE_MAPPING_TABLE_ID=tblub3DbzKIrfh4UA

# Per-platform Airtable views (defaults match this project)
AIRTABLE_STORE_MAPPING_VIEW_DOORDASH=viwBofuDyDvgxnXaJ
AIRTABLE_STORE_MAPPING_VIEW_UBER_EATS=viwGcDUjJOjYo4WSu
AIRTABLE_STORE_MAPPING_VIEW_GRUBHUB=viwI7x6jwp6KKHZV8

# Airtable field names for the store-ID columns (defaults match Nithin’s base)
AIRTABLE_FIELD_DOORDASH_STORE_ID=Doordash StoreID
AIRTABLE_FIELD_UBER_EATS_UUID=UberEats UUID
AIRTABLE_FIELD_GRUBHUB_CID=Grubhub CID

# Optional: financial/promo/ads tables (only if you wire airtable.py financial helpers)
# AIRTABLE_FINANCIAL_BASE_ID=appXXXXXXXXXXXXXX
# AIRTABLE_FINANCIAL_TABLE=Transactions
